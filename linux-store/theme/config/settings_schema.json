  {
    "name": "Payments",
    "settings": [
      {
        "type": "paragraph",
        "content": "Badges show in the footer and under the checkout button. Turn on only what you really accept, then add the same methods in Shopify → Settings → Payments → Manual payment methods (see INSTALL.md)."
      },
      {
        "type": "checkbox",
        "id": "pay_cod",
        "label": "Cash on delivery",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "pay_instapay",
        "label": "InstaPay",
        "default": true
      },
      {
        "type": "text",
        "id": "pay_instapay_address",
        "label": "InstaPay address or phone (optional)",
        "info": "e.g. linux@instapay — shown in \"How to pay\". Blank = \"we'll send the details on WhatsApp\"."
      },
      {
        "type": "image_picker",
        "id": "pay_instapay_logo",
        "label": "InstaPay logo (optional)",
        "info": "Upload the official mark if you have it; blank = LINUX badge."
      },
      {
        "type": "checkbox",
        "id": "pay_vodafone",
        "label": "Vodafone Cash",
        "default": true
      },
      {
        "type": "text",
        "id": "pay_vodafone_number",
        "label": "Vodafone Cash number (optional)",
        "info": "Shown in \"How to pay\". Blank = \"we'll send the details on WhatsApp\"."
      },
      {
        "type": "image_picker",
        "id": "pay_vodafone_logo",
        "label": "Vodafone Cash logo (optional)"
      },
      {
        "type": "checkbox",
        "id": "pay_wallet",
        "label": "Other mobile wallets",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "pay_fawry",
        "label": "Fawry",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "pay_valu",
        "label": "valU instalments",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "pay_card_icons",
        "label": "Show card logos (Visa, Mastercard…)",
        "default": false,
        "info": "Only if your payment provider really takes cards. The logos come from the provider automatically."
      },
      {
        "type": "header",
        "content": "How to pay"
      },
      {
        "type": "checkbox",
        "id": "pay_howto",
        "label": "Show \"How to pay\" in the bag",
        "default": true
