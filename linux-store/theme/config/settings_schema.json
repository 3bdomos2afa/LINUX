      {
        "type": "header",
        "content": "Accent"
      },
      {
        "type": "select",
        "id": "font_accent",
        "label": "Accent font (stickers, seasonal badges, the Studio's \"Fun\" text)",
        "default": "badeen",
        "options": [
          {
            "value": "badeen",
            "label": "Badeen Display (default)"
          },
          {
            "value": "rakkas",
            "label": "Rakkas"
          },
          {
            "value": "baloo",
            "label": "Baloo Bhaijaan 2"
          },
          {
            "value": "none",
            "label": "None — use the heading font"
          }
        ]
      }
    ]
  },
  {
    "name": "Layout & spacing",
    "settings": [
      {
        "type": "range",
        "id": "section_gap",
        "label": "Space between sections",
        "min": 50,
        "max": 150,
        "step": 10,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "gutter_scale",
        "label": "Side padding",
        "min": 50,
        "max": 150,
        "step": 10,
        "unit": "%",
        "default": 100
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "mobile_type_scale",
        "label": "Mobile text size",
        "min": 85,
        "max": 115,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "checkbox",
        "id": "show_tab_bar",
        "label": "Bottom tab bar on phones",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "mobile_two_col",
        "label": "Two product columns on phones (off = one wide column)",
        "default": true
      }
    ]
  },
  {
    "name": "Navigation",
    "settings": [
      {
        "type": "paragraph",
        "content": "Menus themselves are edited in Online Store → Navigation. Menu titles the theme knows (Shop, Customize, Journal, About, Contact…) are translated automatically."
      },
      {
        "type": "link_list",
        "id": "side_menu",
        "label": "Mobile menu",
        "default": "main-menu"
      },
      {
        "type": "text",
        "id": "search_suggestions",
        "label": "Popular searches (comma separated)",
        "default": "Hoodie,Anime,Customize,Sada,Shirt"
      },
      {
        "type": "checkbox",
        "id": "show_locale_switcher",
        "label": "Show language switcher",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_wishlist",
        "label": "Show wishlist (heart) in header and tab bar",
        "default": true
      }
    ]
  },
  {
    "name": "Cart & checkout",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
