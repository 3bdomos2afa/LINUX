[
  {
    "name": "theme_info",
    "theme_name": "LINUX Liquid Glass",
    "theme_version": "4.2.0",
    "theme_author": "LINUX",
    "theme_documentation_url": "https://linux-eg.com",
    "theme_support_url": "https://wa.me/201110351549"
  },
  {
    "name": "Appearance",
    "settings": [
      {
        "type": "select",
        "id": "color_scheme",
        "label": "Scheme",
        "options": [
          {
            "value": "forest",
            "label": "Forest (dark)"
          },
          {
            "value": "cream",
            "label": "Cream (light)"
          }
        ],
        "default": "forest"
      },
      {
        "type": "header",
        "content": "Brand colours"
      },
      {
        "type": "paragraph",
        "content": "Leave a colour empty to keep the LINUX default (forest / cream / lime). Changing these recolours the whole theme: glass, buttons, badges, links."
      },
      {
        "type": "color",
        "id": "brand_forest",
        "label": "Forest (dark base)"
      },
      {
        "type": "color",
        "id": "brand_cream",
        "label": "Cream (headings and glass tint)"
      },
      {
        "type": "color",
        "id": "brand_lime",
        "label": "Lime (accent / buttons)"
      },
      {
        "type": "range",
        "id": "glass_strength",
        "label": "Glass blur",
        "min": 50,
        "max": 150,
        "step": 10,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "glass_tint",
        "label": "Glass tint (lower = clearer)",
        "min": 2,
        "max": 24,
        "step": 1,
        "unit": "%",
        "default": 7,
        "info": "How much cream tint sits on the glass. Lower shows more of the page through it."
      },
      {
        "type": "select",
        "id": "glass_refraction",
        "label": "Liquid refraction",
        "default": "off",
        "options": [
          {
            "value": "off",
            "label": "Off"
          },
          {
            "value": "subtle",
            "label": "Subtle"
          },
          {
            "value": "strong",
            "label": "Strong"
          }
        ],
        "info": "Bends the page at the edges of the header and tab bar like real glass (Chrome/Android). It re-renders on every frame of the video underneath, so it stays off unless you want the effect over performance on low-end phones."
      },
      {
        "type": "range",
        "id": "radius_scale",
        "label": "Corner roundness",
        "min": 60,
        "max": 140,
        "step": 10,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "motion_scale",
        "label": "Motion",
        "min": 0,
        "max": 100,
        "step": 100,
        "unit": "%",
        "default": 100,
        "info": "0 disables all animation"
      },
      {
        "type": "checkbox",
        "id": "show_curtain",
        "label": "Logo curtain on first visit (home page)",
        "default": true
      },
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1200,
        "max": 1680,
        "step": 40,
        "unit": "px",
        "default": 1440
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Social share image"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "paragraph",
        "content": "Arabic uses Thmanyah Sans throughout, including numbers. English uses Froople headings and Mochi Tubby body text. Brand fonts are self-hosted and always enabled."
      },
      {
        "type": "range",
        "id": "type_scale",
        "label": "Text size",
        "min": 85,
        "max": 115,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Headline size",
        "min": 80,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
