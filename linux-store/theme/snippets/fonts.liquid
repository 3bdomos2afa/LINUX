{%- comment -%}
  Self-hosted fonts, one @font-face per role. Only the current language's files
  are preloaded.
    EN  headings: Matcha Rounded (single bold cut)
        everything else: Disney Bubble (single cut, caps-forward display face)
    AR  headings: Thmanyah Serif Display (700 / 900)
        everything else: Palestine (single cut; covers Arabic + Latin + digits)
    numbers / prices: JetBrains Mono — kept for tabular prices on both languages
    system fallbacks are listed after each family in glass.css; if a glyph is
    missing (e.g. Palestine has no ASCII punctuation beyond . , -) the browser
    falls through to the next family in the stack.
{%- endcomment -%}
{%- if is_rtl -%}
  {{ 'thmanyah-display-900.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ 'palestine.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ 'disney-bubble.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{%- else -%}
  {{ 'matcha-rounded.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ 'disney-bubble.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{%- endif -%}
<style>
  @font-face { font-family: "Matcha Rounded"; font-style: normal; font-weight: 400 900; font-display: swap; src: url("{{ 'matcha-rounded.woff2' | asset_url }}") format("woff2"); }
  @font-face { font-family: "Disney Bubble"; font-style: normal; font-weight: 300 900; font-display: swap; src: url("{{ 'disney-bubble.woff2' | asset_url }}") format("woff2"); }
  @font-face { font-family: "Thmanyah Display"; font-style: normal; font-weight: 700; font-display: swap; src: url("{{ 'thmanyah-display-700.woff2' | asset_url }}") format("woff2"); }
  @font-face { font-family: "Thmanyah Display"; font-style: normal; font-weight: 800 900; font-display: swap; src: url("{{ 'thmanyah-display-900.woff2' | asset_url }}") format("woff2"); }
  {%- comment -%} Palestine ships empty Latin outlines → subset to Arabic + digits; Latin words inside Arabic text fall to Disney Bubble {%- endcomment -%}
  @font-face { font-family: "Palestine"; font-style: normal; font-weight: 300 900; font-display: swap; src: url("{{ 'palestine.woff2' | asset_url }}") format("woff2"); unicode-range: U+0020, U+002E, U+0030-0039, U+00A0, U+0600-06FF, U+2013-2014, U+2018-2019, U+201C-201D, U+2026, U+FB50-FEFF; }
  @font-face { font-family: "JetBrains Mono"; font-style: normal; font-weight: 400 700; font-display: swap; src: url("{{ 'jetbrains-mono-latin.woff2' | asset_url }}") format("woff2"); unicode-range: U+0000-00FF, U+2000-206F, U+20AC, U+2212, U+FEFF, U+FFFD; }
</style>
