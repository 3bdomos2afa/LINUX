{%- comment -%}
  Brand type (Theme settings → Typography). One font per role and language:
  Arabic headings / text, English headings / text, and an optional accent font
  for stickers and playful labels. Only the current language's files are
  preloaded; every family is split per script, so nothing else downloads
  unless a page actually shows that script.
  Default: Rakkas (Egyptian film-poster Ruqaa) + Alan Sans for Arabic,
  Unbounded + Fustat for English, Badeen Display as the accent.
  Params: is_rtl
{%- endcomment -%}
{%- liquid
  assign ar_head = settings.font_ar_heading | default: 'rakkas'
  assign ar_body = settings.font_ar_body | default: 'alan'
  assign en_head = settings.font_en_heading | default: 'unbounded'
  assign en_body = settings.font_en_body | default: 'fustat'
  assign accent = settings.font_accent | default: 'badeen'
  assign keys = ar_head | append: ',' | append: ar_body | append: ',' | append: en_head | append: ',' | append: en_body
  if accent != 'none'
    assign keys = keys | append: ',' | append: accent
  endif
  assign keys = keys | split: ',' | uniq

  comment
    Per-family weights: static display faces (Rakkas, Badeen, Bagel) use their
    one master; variable faces use the weights that read best on dark glass.
  endcomment
  case ar_head
    when 'rakkas', 'badeen'
      assign ar_w_head = 400
      assign ar_scale = 1.06
    when 'thmanyah'
      assign ar_w_head = 900
      assign ar_scale = 1
    else
      assign ar_w_head = 800
      assign ar_scale = 1
  endcase
  case ar_body
    when 'fustat'
      assign ar_w_body = 500
      assign ar_w_ui = 600
      assign ar_body_px = 18
    when 'thmanyah'
      assign ar_w_body = 400
      assign ar_w_ui = 500
      assign ar_body_px = 17
    else
      assign ar_w_body = 400
      assign ar_w_ui = 600
      assign ar_body_px = 17
  endcase
  case en_head
    when 'unbounded'
      assign en_w_head = 800
      assign en_scale = 0.84
      assign en_tracking = '-.02em'
    when 'rakkas', 'bagel', 'froople'
      assign en_w_head = 400
      assign en_scale = 1
      assign en_tracking = '0'
    else
      assign en_w_head = 800
      assign en_scale = 1
      assign en_tracking = '-.01em'
  endcase
  case en_body
    when 'mochi'
      assign en_w_body = 400
      assign en_w_ui = 400
    else
      assign en_w_body = 400
      assign en_w_ui = 600
  endcase
  case accent
    when 'baloo'
      assign w_accent = 800
    else
      assign w_accent = 400
  endcase
-%}
{%- if is_rtl -%}
  {%- render 'font-family', key: ar_head, mode: 'preload-ar' -%}
  {%- if ar_body != ar_head -%}{%- render 'font-family', key: ar_body, mode: 'preload-ar' -%}{%- endif -%}
{%- else -%}
  {%- render 'font-family', key: en_head, mode: 'preload-la' -%}
  {%- if en_body != en_head -%}{%- render 'font-family', key: en_body, mode: 'preload-la' -%}{%- endif -%}
{%- endif -%}
{%- capture f_ar_head -%}{% render 'font-family', key: ar_head, mode: 'name' %}{%- endcapture -%}
{%- capture f_ar_body -%}{% render 'font-family', key: ar_body, mode: 'name' %}{%- endcapture -%}
{%- capture f_en_head -%}{% render 'font-family', key: en_head, mode: 'name' %}{%- endcapture -%}
{%- capture f_en_body -%}{% render 'font-family', key: en_body, mode: 'name' %}{%- endcapture -%}
{%- if accent != 'none' -%}{%- capture f_accent -%}{% render 'font-family', key: accent, mode: 'name' %}, {%- endcapture -%}{%- endif -%}
<style>
  {%- for key in keys -%}{% render 'font-family', key: key, mode: 'face' %}{%- endfor %}
  html:root { --font-display: {{ f_en_head }}, {{ f_ar_head }}, sans-serif; --font-body: {{ f_en_body }}, {{ f_ar_body }}, sans-serif; --font-accent: {{ f_accent }}{{ f_en_head }}, {{ f_ar_body }}, sans-serif; --w-heading: {{ en_w_head }}; --w-sub: {{ en_w_ui }}; --w-body: {{ en_w_body }}; --w-ui: {{ en_w_ui }}; --w-accent: {{ w_accent }}; --display-scale: {{ en_scale }}; --display-tracking: {{ en_tracking }}; }
  html[dir="rtl"]:root { --font-display: {{ f_ar_head }}, {{ f_en_head }}, sans-serif; --font-body: {{ f_ar_body }}, {{ f_en_body }}, sans-serif; --font-accent: {{ f_accent }}{{ f_ar_head }}, {{ f_ar_body }}, sans-serif; --w-heading: {{ ar_w_head }}; --w-sub: {{ ar_w_ui }}; --w-body: {{ ar_w_body }}; --w-ui: {{ ar_w_ui }}; --w-accent: {{ w_accent }}; --display-scale: {{ ar_scale }}; --display-tracking: 0; --fs-body: calc({{ ar_body_px }}px * var(--type-scale)); }
</style>
