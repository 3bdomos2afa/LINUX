{%- if mascot != blank -%}{% render 'mascot', name: mascot, width: 200, class: 'sa__mascot' %}{%- endif -%}
{%- if show_badge and badge != blank -%}
<div class="sa__temp sa__temp--frost">
  <svg class="sa__temp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M12 2.5V21.5M20.2 7.3L3.8 16.8M20.2 16.8L3.8 7.3M14.6 5.1L12 7.6L9.4 5.1M19.3 10.8L15.8 9.8L16.7 6.3M16.7 17.7L15.8 14.2L19.3 13.2M9.4 18.9L12 16.4L14.6 18.9M4.7 13.2L8.2 14.2L7.3 17.7M7.3 6.3L8.2 9.8L4.7 10.8"/></svg>
  <span class="sa__temp-val">{{ badge }}</span>
  {%- if caption != blank -%}<span class="sa__temp-cap">{{ caption }}</span>{%- endif -%}
</div>
{%- endif -%}
{%- endif -%}
