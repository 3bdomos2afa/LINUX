<svg class="sa__pine sa__pine--b" viewBox="0 0 60 100" focusable="false"><path d="M26 82h8v16h-8Z" fill="#3a2a1c"/><path d="M30 4 14 32h7L8 56h9L3 84h54L43 56h9L39 32h7Z" fill="#0a4a33" stroke="#043020" stroke-width="2.5" stroke-linejoin="round"/><path d="M30 4 22 18q4 3 8 0 4 3 8 0ZM14 32h32l-2 3q-4 3-8 0-4 3-8 0-4 3-8 0-3 2-6-3ZM8 56h44l-2 3q-5 3-10 0-5 3-10 0-5 3-10 0-5 3-9-3Z" fill="#f4fbff"/></svg>
