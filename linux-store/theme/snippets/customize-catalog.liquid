{%- if product != blank -%}
  {
    "id": {{ product.id | json }},
    "options": [{%- for option in product.options -%}{{ option.name | default: option | append: '' | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%}],
    "variants": [
      {%- for variant in product.variants -%}
        {"id": {{ variant.id | json }}, "price": {{ variant.price | json }}, "available": {{ variant.available | json }}, "cart_quantity": {{ cart | item_count_for_variant: variant.id | default: 0 | json }}, "options": [{%- for option in variant.options -%}{{ option.name | default: option | append: '' | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%}], "quantity_price_breaks": [
          {%- for price_break in variant.quantity_price_breaks -%}
            {"minimum_quantity": {{ price_break.minimum_quantity | json }}, "price": {{ price_break.price | json }}}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
{%- else -%}null{%- endif -%}
