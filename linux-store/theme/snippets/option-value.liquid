{%- comment -%} Localized option value: 'black' -> 'أسود' in Arabic; sizes always uppercase (xl -> XL); multi-word values are translated word by word; unknown English values capitalized. {%- endcomment -%}
{%- assign k = value | downcase | strip | replace: ' ', '_' -%}
{%- assign key = 'products.option_values.' | append: k -%}
{%- assign out = key | t -%}
{%- assign size_keys = 'xs,s,m,l,xl,2xl,xxl,3xl,xxxl,4xl,os,one_size' | split: ',' -%}
{%- if size_keys contains k -%}{{ value | upcase }}
{%- elsif out contains 'translation missing' -%}
  {%- if request.locale.iso_code == 'ar' and value contains ' ' -%}
    {%- assign words = value | split: ' ' -%}{%- capture wt -%}{%- for w in words -%}{%- assign wk = 'products.option_values.' | append: w | downcase -%}{%- assign wv = wk | t -%}{%- if wv contains 'translation missing' -%}{{ w }}{%- else -%}{{ wv }}{%- endif -%}{%- unless forloop.last %} {% endunless -%}{%- endfor -%}{%- endcapture -%}{{ wt | strip }}
  {%- else -%}{{ value | capitalize }}{%- endif -%}
{%- else -%}{{ out }}{%- endif -%}
