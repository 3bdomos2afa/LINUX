  <svg class="sa__rays" viewBox="0 0 200 200" fill="none" stroke-linecap="round" focusable="false"><path stroke="#043020" stroke-width="13" d="M100 28L100 3M137 35.9L144.5 22.9M162.4 64L184 51.5M174 100L189 100M162.4 136L184 148.5M137 164.1L144.5 177.1M100 172L100 197M63 164.1L55.5 177.1M37.6 136L16 148.5M26 100L11 100M37.6 64L16 51.5M63 35.9L55.5 22.9"/><path stroke="#ffb627" stroke-width="7" d="M100 28L100 3M137 35.9L144.5 22.9M162.4 64L184 51.5M174 100L189 100M162.4 136L184 148.5M137 164.1L144.5 177.1M100 172L100 197M63 164.1L55.5 177.1M37.6 136L16 148.5M26 100L11 100M37.6 64L16 51.5M63 35.9L55.5 22.9"/></svg>
