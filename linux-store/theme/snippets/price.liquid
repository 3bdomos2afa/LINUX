{%- comment -%} Price for a product or variant with discount percentage. {%- endcomment -%}
{%- liquid
  if variant
    assign price = variant.price
    assign compare = variant.compare_at_price
    assign varies = false
  else
    assign price = product.price_min
    assign compare = product.compare_at_price_max
    assign varies = product.price_varies
  endif
  assign on_sale = false
  if compare > price
    assign on_sale = true
  endif
-%}
<span class="price{% if on_sale %} price--sale{% endif %}{% if class %} {{ class }}{% endif %}" data-price>
  {%- if varies and product.price_min != product.price_max -%}<span class="price__from">{{ 'products.from' | t }}</span> {% endif -%}
  <span class="price__current{% if on_sale %} price__sale{% endif %}" data-price-current>{% render 'money', amount: price %}</span>
  {%- if on_sale -%}
    {%- assign compare_float = compare | times: 1.0 -%}
    {%- assign discount_pct = compare | minus: price | times: 100 | divided_by: compare_float | round -%}
    {%- if request.locale.iso_code == 'ar' -%}
      <span class="price__discount">{{ 'products.sale' | t }} {% render 'digits', value: discount_pct %}٪</span>
    {%- else -%}
      <span class="price__discount">-{{ discount_pct }}%</span>
    {%- endif -%}
  {%- endif -%}
  {%- if on_sale and settings.card_show_compare != false -%}<s class="price__compare" data-price-compare>{% render 'money', amount: compare %}</s>{%- endif -%}
</span>
