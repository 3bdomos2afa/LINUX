{%- comment -%}
  Product title with word-level Arabic fallback. If the merchant translated the
  product in Shopify (Translate & Adapt) the title already arrives localised
  and contains Arabic, so it is shown as-is. Otherwise, in Arabic, each English
  word is looked up in products.option_values (hoodie → هودي, black → أسود …)
  and unknown words stay as they are.
  Usage: {% render 'product-title', title: product.title %}
{%- endcomment -%}
{%- if request.locale.iso_code == 'ar' -%}
  {%- assign has_ar = false -%}
  {%- assign probe = 'ا,ب,ت,ث,ج,ح,خ,د,ذ,ر,ز,س,ش,ص,ض,ط,ظ,ع,غ,ف,ق,ك,ل,م,ن,ه,و,ي,ى,ة,ء,أ,إ,آ,ؤ,ئ' | split: ',' -%}
  {%- for ch in probe -%}{%- if title contains ch -%}{%- assign has_ar = true -%}{%- break -%}{%- endif -%}{%- endfor -%}
  {%- if has_ar -%}
    {{- title -}}
  {%- else -%}
    {%- assign words = title | split: ' ' -%}
    {%- comment -%} Arabic puts the garment first: "Anime Shirt Black" → تيشيرت أنمي أسود. {%- endcomment -%}
    {%- assign noun_at = -1 -%}
    {%- for w in words -%}
      {%- assign lw = w | downcase -%}
      {%- if lw == 'hoodie' or lw == 'shirt' or lw == 't-shirt' or lw == 'tshirt' or lw == 'tee' or lw == 'sweatshirt' -%}{%- assign noun_at = forloop.index0 -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
    {%- if noun_at > 0 -%}
      {%- capture reordered -%}{{ words[noun_at] }}{%- for w in words -%}{%- unless forloop.index0 == noun_at %} {{ w }}{%- endunless -%}{%- endfor -%}{%- endcapture -%}
      {%- assign words = reordered | split: ' ' -%}
    {%- endif -%}
    {%- capture out -%}
      {%- for w in words -%}
        {%- comment -%} Hyphenated words keep their key first (t-shirt, as in LINUX.words), then fall back to the underscore form. {%- endcomment -%}
        {%- assign k = w | downcase | strip -%}
        {%- assign key = 'products.option_values.' | append: k -%}
        {%- assign tr = key | t -%}
        {%- assign tr_lc = tr | downcase -%}
        {%- if tr_lc contains 'translation missing' and k contains '-' -%}
          {%- assign key = 'products.option_values.' | append: k | replace: '-', '_' -%}
          {%- assign tr = key | t -%}
          {%- assign tr_lc = tr | downcase -%}
        {%- endif -%}
        {%- if tr_lc contains 'translation missing' -%}{{ w }}{%- else -%}{{ tr }}{%- endif -%}
        {%- unless forloop.last %} {% endunless -%}
      {%- endfor -%}
    {%- endcapture -%}
    {{- out | strip -}}
  {%- endif -%}
{%- else -%}
  {{- title -}}
{%- endif -%}
