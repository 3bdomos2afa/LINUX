{%- comment -%} Shared by the cart drawer and cart page. Re-rendered via the Section Rendering API. {%- endcomment -%}
{%- comment -%}
  Deliberately no free-shipping box here — on the cart page or in the drawer.
  The drawer carries both halves of it above this region: the island shows the
  distance left (snippets/ship-meter.liquid) and the offer strip states the
  threshold (snippets/offer-bar.liquid). Repeating either one inside the lines —
  which re-render on every quantity change — would only cost vertical space.

  On /cart this snippet is the whole left column, and it stays shipping-free by
  design: the page keeps its lines, the summary and the trust list, nothing else.
{%- endcomment -%}
{%- if cart.item_count > 0 -%}
  <ul class="cart-lines" role="list">
    {%- for item in cart.items -%}
      <li class="cart-line glass glass--clear" data-line data-key="{{ item.key | escape }}"{% if item.properties['_bundle_id'] != blank %} data-bundle-id="{{ item.properties['_bundle_id'] | escape }}"{% endif %} style="--i: {{ forloop.index0 }}">
        {%- liquid
          assign mock_front = item.properties['Front mockup'] | default: ''
          assign mock_back = item.properties['Back mockup'] | default: ''
          assign front_prefix = mock_front | slice: 0, 8
          assign back_prefix = mock_back | slice: 0, 8
          assign front_start = mock_front | slice: 0, 1
          assign back_start = mock_back | slice: 0, 1
          unless front_prefix == 'https://' or front_start == '/'
            assign mock_front = ''
          endunless
          unless back_prefix == 'https://' or back_start == '/'
            assign mock_back = ''
          endunless
          assign mockup = ''
          if mock_back != '' and mock_back contains '/uploads/'
            assign mockup = mock_back
          elsif mock_front != '' and mock_front contains '/uploads/'
            assign mockup = mock_front
          endif
          assign has_mockup = false
          if mockup != ''
            assign has_mockup = true
          endif
        -%}
        {%- capture localized_item_title -%}{% render 'product-title', title: item.product.title %}{%- endcapture -%}
        {%- assign localized_item_title = localized_item_title | strip -%}
        <a class="cart-line__media{% if has_mockup %} cart-line__media--mockup{% endif %}" href="{{ item.url | escape }}">
          {%- if has_mockup -%}
            <img src="{{ mockup | escape }}" alt="{{ 'customize.mockup' | t | escape }}" width="84" height="84" loading="lazy">
          {%- elsif item.image -%}<img src="{{ item.image | image_url: width: 200 }}" alt="{{ localized_item_title | escape }}" width="84" height="104" loading="lazy">{%- endif -%}
        </a>
        <div class="cart-line__body">
          <a class="cart-line__title" href="{{ item.url }}">{{ localized_item_title }}</a>
          {%- unless item.product.has_only_default_variant -%}<p class="cart-line__meta">{%- for opt in item.variant.options -%}{% render 'option-value', value: opt %}{%- unless forloop.last %} / {% endunless -%}{%- endfor -%}</p>{%- endunless -%}
          {%- if item.properties['Bundle offer'] != blank -%}
            <div class="cart-line__bundle" aria-label="{{ 'cart.bundle_offer' | t }}">
              <span class="cart-line__bundle-icon">{% render 'icon', name: 'tag', px: 14 %}</span>
              <span>
                <strong>{{ 'cart.bundle_offer' | t }}</strong>
                <small>{{ item.properties['Bundle offer'] | escape }}</small>
                {%- if item.properties['Expected bundle discount'] != blank -%}{%- capture expected_discount -%}{% render 'digits', value: item.properties['Expected bundle discount'] %}{%- endcapture -%}<small class="muted">{% render 'property-label', name: 'Expected bundle discount' %}: {{ expected_discount | strip | escape }}</small>{%- endif -%}
              </span>
            </div>
          {%- endif -%}
          {%- liquid
            assign prop_count = 0
            for p in item.properties
              assign fc = p.first | slice: 0
              assign skip_bundle_summary = false
              if item.properties['Bundle offer'] != blank
                if p.first == 'Bundle offer' or p.first == 'Expected bundle discount'
                  assign skip_bundle_summary = true
                endif
              endif
              if p.last != blank and fc != '_' and p.first != 'Front mockup' and p.first != 'Back mockup' and skip_bundle_summary == false
                assign prop_count = prop_count | plus: 1
              endif
            endfor
          -%}
          {%- if prop_count > 0 -%}
          <details class="cart-line__props"{% if prop_count <= 3 or item.properties['Bundle offer'] != blank %} open{% endif %}>
            <summary>{{ 'cart.details' | t }} · {% render 'digits', value: prop_count %}</summary>
            {%- for p in item.properties -%}
              {%- assign first_char = p.first | slice: 0 -%}
              {%- liquid
                assign skip_bundle_summary = false
                if item.properties['Bundle offer'] != blank
                  if p.first == 'Bundle offer' or p.first == 'Expected bundle discount'
                    assign skip_bundle_summary = true
                  endif
                endif
                assign property_value = p.last | append: ''
                assign file_prefix = property_value | slice: 0, 8
                assign file_start = property_value | slice: 0, 1
                assign is_file = false
                if property_value contains '/uploads/'
                  if file_prefix == 'https://' or file_start == '/'
                    assign is_file = true
                  endif
                endif
              -%}
              {%- if p.last != blank and first_char != '_' and p.first != 'Front mockup' and p.first != 'Back mockup' and skip_bundle_summary == false -%}
                <p class="cart-line__meta">{% render 'property-label', name: p.first %}:
                  {%- if is_file -%} <a href="{{ property_value | escape }}" target="_blank" rel="noopener">{{ 'cart.view_file' | t }}</a>
                  {%- elsif property_value contains 'upload:' -%} {{ property_value | remove_first: 'upload:' | escape }}
                  {%- elsif p.first == 'Method' or p.first == 'Garment' or p.first == 'Colour' -%} {%- capture property_label -%}{% render 'option-value', value: property_value %}{%- endcapture -%} {{ property_label | escape }}
                  {%- elsif p.first == 'Expected bundle discount' or p.first == 'Bundle piece' -%} {%- capture property_display -%}{% render 'digits', value: property_value %}{%- endcapture -%} {{ property_display | strip | escape }}
                  {%- elsif p.first == 'Piece' -%} {%- capture piece_display -%}{% render 'digits', value: property_value %}{%- endcapture -%} {{ piece_display | strip | escape }}
                  {%- elsif p.first == 'Front placement' or p.first == 'Back placement' -%} {% render 'placement-value', value: property_value %}
                  {%- elsif p.first == 'Size' -%} {%- capture size_display -%}{% render 'option-value', value: property_value %}{%- endcapture -%} {{ size_display | strip | escape }}
                  {%- elsif p.first == 'Sides' -%}
                    {%- if property_value == 'Front + Back' -%} {{ 'customize.both_sides' | t }}
                    {%- elsif property_value == 'Front' -%} {{ 'customize.front' | t }}
                    {%- elsif property_value == 'Back' -%} {{ 'customize.back' | t }}
                    {%- else -%} {{ property_value | escape }}{%- endif -%}
                  {%- elsif p.first contains 'position' -%} <span class="mono">{{ property_value | escape }}</span>
                  {%- else -%} {{ property_value | escape }}{%- endif -%}
                </p>
              {%- endif -%}
            {%- endfor -%}
            {%- if mock_front != '' and mock_front contains '/uploads/' -%}<p class="cart-line__meta"><a href="{{ mock_front | escape }}" target="_blank" rel="noopener">{{ 'customize.view_mockup' | t }} · {{ 'customize.front' | t }} ↗</a></p>{%- endif -%}
            {%- if mock_back != '' and mock_back contains '/uploads/' -%}<p class="cart-line__meta"><a href="{{ mock_back | escape }}" target="_blank" rel="noopener">{{ 'customize.view_mockup' | t }} · {{ 'customize.back' | t }} ↗</a></p>{%- endif -%}
          </details>
          {%- endif -%}
          {%- if item.properties['Bundle offer'] != blank -%}
            {%- assign actual_discount = 0 -%}
            {%- for allocation in item.discount_allocations -%}{%- assign actual_discount = actual_discount | plus: allocation.amount -%}{%- endfor -%}
            <div class="cart-line__discount small">
              <p>{{ 'cart.bundle_actual' | t }} {% render 'money', amount: actual_discount %}</p>
              {%- for allocation in item.discount_allocations -%}
                <p class="muted">{{ allocation.discount_application.title | escape }}: {% render 'money', amount: allocation.amount %}</p>
              {%- endfor -%}
              <p class="muted">{{ 'cart.bundle_note' | t }}</p>
            </div>
          {%- endif -%}
          <div class="cart-line__row">
            <div class="qty qty--sm">
              <button class="qty__btn" type="button" data-qty-change="-1" data-key="{{ item.key }}" aria-label="{{ 'cart.decrease' | t }}">−</button>
              <input class="qty__input" type="number" value="{{ item.quantity }}" min="0" step="1" inputmode="numeric" data-localized-number data-qty-input data-key="{{ item.key }}" aria-label="{{ 'cart.quantity' | t }}">
              <button class="qty__btn" type="button" data-qty-change="1" data-key="{{ item.key }}" aria-label="{{ 'cart.increase' | t }}">+</button>
            </div>
            <span class="cart-line__price">{% render 'money', amount: item.final_line_price %}</span>
          </div>
          <button class="cart-line__remove" type="button" data-line-remove data-key="{{ item.key }}">{{ 'cart.remove' | t }}</button>
        </div>
      </li>
    {%- endfor -%}
  </ul>
{%- else -%}
  <div class="cart-empty">
    {% render 'mascot', name: 'classic', width: 140 %}
    <h3>{{ 'cart.empty_title' | t }}</h3>
    <p class="muted">{{ 'cart.empty_body' | t }}</p>
    <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary" data-drawer-close>{{ 'cart.start_shopping' | t }}</a>
  </div>
{%- endif -%}
