{%- comment -%}
  Localised price. Shopify's `money` filter always uses the shop's money format
  ("LE 649.00"), so Arabic pages showed a Latin "LE". In Arabic we print the
  amount with the theme's own currency word (Theme settings → currency_ar) and
  drop the ".00" when the price is a whole number.
  Usage: {% render 'money', amount: variant.price %}
{%- endcomment -%}
{%- if request.locale.iso_code == 'ar' -%}
  {%- assign a = amount | money_without_currency -%}
  {%- assign tail = a | slice: -3, 3 -%}
  {%- if tail == '.00' -%}{%- assign a = a | remove_last: '.00' -%}{%- endif -%}
  {%- assign cur = settings.currency_ar | default: 'جنيه' -%}
  {{ a }} {{ cur }}
{%- else -%}
  {{ amount | money }}
{%- endif -%}
