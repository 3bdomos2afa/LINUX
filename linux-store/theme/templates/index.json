{
  "sections": {
    "hero": {
      "type": "hero-embroidery",
      "settings": {
        "height": 100,
        "height_mobile": 100,
        "overlay": 0,
        "layout": "below",
        "show_headline": true,
        "show_cta": true,
        "cta_url": "/collections/winter-collection",
        "cta2_url": "/pages/customize",
        "show_trust": true
      }
    },
    "marquee": {
      "type": "marquee",
      "blocks": {
        "m1": { "type": "item", "settings": { "key": "home.marquee_1", "code": "LINUX10" } },
        "m2": { "type": "item", "settings": { "key": "home.marquee_2" } },
        "m3": { "type": "item", "settings": { "key": "home.marquee_3" } },
        "m4": { "type": "item", "settings": { "key": "home.marquee_4" } },
        "m5": { "type": "item", "settings": { "key": "home.marquee_5" } }
      },
      "block_order": ["m1", "m2", "m3", "m4", "m5"],
      "settings": {}
    },
    "bestsellers": {
      "type": "product-carousel",
      "settings": {
        "collection": "winter-collection",
        "limit": 8
      }
    },
    "collections": {
      "type": "featured-collections",
      "blocks": {
        "c1": { "type": "collection", "settings": { "collection": "winter-collection", "size": "large" } },
        "c2": { "type": "collection", "settings": { "collection": "summer-collection", "size": "small" } },
        "c3": { "type": "collection", "settings": { "collection": "customize-print", "size": "small", "key_label": "home.collections_customize_label", "key_sub": "home.collections_customize_sub" } },
        "c4": { "type": "collection", "settings": { "collection": "all", "size": "wide", "key_label": "home.collections_all_label" } }
      },
      "block_order": ["c1", "c2", "c3", "c4"],
      "settings": {}
    }
  },
  "order": [
    "hero",
    "marquee",
    "bestsellers",
    "collections"
  ]
}
