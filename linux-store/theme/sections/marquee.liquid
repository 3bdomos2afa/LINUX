{%- if section.blocks.size > 0 -%}
{%- assign ribbon_style = section.settings.style | default: 'ribbons' -%}
{%- capture ribbon_items -%}
  {%- for i in (1..2) -%}
    {%- for block in section.blocks -%}
      <span class="marquee__item"{% if i > 1 %} aria-hidden="true"{% endif %} {{ block.shopify_attributes }}>
        <span class="marquee__text">{% render 'tr', value: block.settings.text, key: block.settings.key %}</span>
        {%- if block.settings.code != blank -%}
          <button class="marquee__code" type="button" data-copy="{{ block.settings.code | escape }}" data-copy-label="{{ 'announcement.code_copied' | t | escape }}"{% if i > 1 %} tabindex="-1"{% endif %}><span class="marquee__code-label">{{ block.settings.code }}</span></button>
        {%- endif -%}
        {% render 'icon', name: 'sparkle', px: 18 %}
      </span>
    {%- endfor -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if ribbon_style == 'ribbons' -%}
  <div class="ribbons" role="region" aria-label="{{ 'sections.header.announcement' | t | escape }}">
    <div class="ribbon ribbon--lime"><div class="marquee__track">{{ ribbon_items }}</div></div>
    <div class="ribbon ribbon--cream" aria-hidden="true" inert><div class="marquee__track">{{ ribbon_items }}</div></div>
  </div>
{%- else -%}
  <div class="marquee" role="region" aria-label="{{ 'sections.header.announcement' | t | escape }}">
    <div class="marquee__track">{{ ribbon_items }}</div>
  </div>
{%- endif -%}
{%- endif -%}
{% schema %}
{
  "name": "Marquee",
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "key",
          "label": "Translation key (e.g. home.marquee_1)"
        },
        {
          "type": "text",
          "id": "code",
          "label": "Discount code (click to copy)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "default": "ribbons",
      "options": [
        {
          "value": "ribbons",
          "label": "Woven ribbons"
        },
        {
          "value": "classic",
          "label": "Classic ticker"
        }
      ]
    }
  ]
}
{% endschema %}
