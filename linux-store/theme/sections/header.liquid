{%- liquid
  assign s = section.settings
  assign menu = s.menu
  if menu.links == blank
    assign menu_handle = s.menu.handle | default: s.menu
    assign menu = linklists[menu_handle]
  endif
-%}

{%- if s.show_announcement -%}
  {%- liquid
    assign ann_blocks = section.blocks | where: 'type', 'announcement'
    assign fs_cents = settings.free_shipping_threshold | default: 0 | times: 100
    capture fs_amount
      render 'money', amount: fs_cents
    endcapture
    assign fs_amount = fs_amount | strip | remove: '.00'
    assign ann_style = s.announcement_style | default: 'rotate'
    assign cd_label = s.announcement_countdown_label
    if cd_label == blank
      assign cd_label = 'sections.hero.countdown_label' | t
    endif
  -%}
  {%- if ann_style == 'marquee' or ann_blocks.size == 0 -%}
    {%- capture announcement -%}
      {%- if ann_blocks.size > 0 -%}
        {%- for block in ann_blocks -%}
          {%- if block.settings.text != blank -%}{{ block.settings.text }}{%- elsif block.settings.key != blank -%}{{ block.settings.key | t: amount: fs_amount }}{%- endif -%}
          {%- if block.settings.code != blank %} · {{ block.settings.code | strip }}{% endif -%}
          {%- unless forloop.last %}<span class="announcement__dot"></span>{% endunless -%}
        {%- endfor -%}
      {%- else -%}
        {%- render 'tr', value: s.announcement_text, key: 'home.announcement' -%}
      {%- endif -%}
    {%- endcapture -%}
    <div class="announcement" role="region" aria-label="{{ 'sections.header.announcement' | t }}">
      <div class="announcement__track" aria-hidden="true">
        {%- for i in (1..6) -%}
          <span class="announcement__item">{{ announcement }}<span class="announcement__dot"></span></span>
        {%- endfor -%}
      </div>
      <span class="visually-hidden">{{ announcement | strip_html }}</span>
    </div>
  {%- else -%}
    <div class="announce" role="region" aria-roledescription="carousel" aria-label="{{ 'sections.header.announcement' | t }}" data-announce data-interval="{{ s.announcement_interval | default: 5 }}">
      <div class="announce__inner">
        {%- if ann_blocks.size > 1 -%}
          <button class="announce__nav" type="button" data-announce-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left', px: 16 %}</button>
        {%- endif -%}
        <div class="announce__viewport">
          {%- for block in ann_blocks -%}
            {%- liquid
              assign msg = block.settings.text
              if msg == blank and block.settings.key != blank
                assign msg = block.settings.key | t: amount: fs_amount
              endif
              assign ann_icon = block.settings.icon | default: 'sparkle'
            -%}
            <p class="announce__slide{% if forloop.first %} is-active{% endif %}" data-announce-slide role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ forloop.length }}"{% unless forloop.first %} aria-hidden="true" inert{% endunless %} {{ block.shopify_attributes }}>
              {%- if ann_icon != 'none' -%}{%- render 'icon', name: ann_icon, px: 15 -%}{%- endif -%}
              {%- if block.settings.link != blank -%}
                <a class="announce__text" href="{% render 'nav-url', url: block.settings.link %}">{{ msg }}</a>
              {%- else -%}
                <span class="announce__text">{{ msg }}</span>
              {%- endif -%}
              {%- if block.settings.code != blank -%}
                <button class="announce__code" type="button" data-copy="{{ block.settings.code | strip | escape }}" data-copy-label="{{ 'announcement.code_copied' | t | escape }}" aria-label="{{ 'cart.offer_copy' | t: code: block.settings.code | escape }}">
                  <span>{{ block.settings.code | strip }}</span>{%- render 'icon', name: 'copy', px: 12 -%}
                </button>
              {%- endif -%}
            </p>
          {%- endfor -%}
        </div>
        {%- if s.announcement_countdown_end != blank -%}
          <div class="announce__timer" data-countdown data-countdown-end="{{ s.announcement_countdown_end | strip | escape }}" hidden>
            <p class="announce__timer-row" data-countdown-active>
              {%- render 'icon', name: 'clock', px: 13 -%}<span class="announce__timer-label">{{ cd_label | escape }}</span>
              <span class="announce__clock" dir="ltr" role="timer"><span data-cd="hours">--</span>:<span data-cd="minutes">--</span>:<span data-cd="seconds">--</span></span>
            </p>
            <p class="announce__timer-row" data-countdown-expired>{{ 'sections.hero.countdown_expired' | t }}</p>
          </div>
        {%- endif -%}
        {%- if ann_blocks.size > 1 -%}
          <button class="announce__nav" type="button" data-announce-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right', px: 16 %}</button>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
{%- endif -%}

<div class="header-zone" data-header-zone>
  <header class="header glass" id="site-header" data-header data-lens role="banner">
    <div class="header__inner">
      <div class="header__start">
        <button class="icon-btn header__menu" type="button" data-drawer-open="menu" aria-label="{{ 'sections.header.menu' | t }}" aria-expanded="false" aria-controls="menu-drawer">
          {% render 'icon', name: 'menu' %}
        </button>
        <nav class="header__nav" aria-label="{{ 'sections.header.main_menu' | t }}">
          {%- for link in menu.links -%}
            {%- if link.links.size > 0 -%}
              <div class="nav-item nav-item--mega" data-mega>
                <a href="{% render 'nav-url', url: link.url, title: link.title %}" class="nav-link{% if link.active or link.child_active %} is-active{% endif %}" aria-haspopup="true" aria-expanded="false">
                  {% render 'menu-title', title: link.title %}{% render 'icon', name: 'chevron-down', px: 14, class: 'nav-link__caret' %}
                </a>
                <div class="mega glass" role="menu">
                  <div class="mega__cols">
                    <div class="mega__col">
                      {%- for child in link.links -%}
                        <a href="{% render 'nav-url', url: child.url, title: child.title %}" class="mega__link{% if child.active %} is-active{% endif %}" role="menuitem">
                          <span>{% render 'menu-title', title: child.title %}</span>{% render 'icon', name: 'arrow-right', px: 16 %}
                        </a>
                      {%- endfor -%}
                    </div>
                    {%- for block in section.blocks -%}
                      {%- if block.type == 'mega_promo' and block.settings.menu_item == link.title -%}
                        {%- assign promo_url = block.settings.link | default: link.url -%}
                        <a href="{% render 'nav-url', url: promo_url %}" class="mega__promo media" {{ block.shopify_attributes }}>
                          {%- if block.settings.image -%}
                            <img src="{{ block.settings.image | image_url: width: 640 }}" alt="{{ block.settings.label | escape }}" width="320" height="200" loading="lazy">
                          {%- else -%}
                            <img src="{{ 'brand-campaign.webp' | asset_url }}" alt="" width="320" height="200" loading="lazy">
                          {%- endif -%}
                          <span class="mega__promo-label chip">{% render 'tr', value: block.settings.label, key: 'home.mega_promo' %}</span>
                        </a>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>
              </div>
            {%- else -%}
              <a href="{% render 'nav-url', url: link.url, title: link.title %}" class="nav-link{% if link.active %} is-active{% endif %}">{% render 'menu-title', title: link.title %}</a>
            {%- endif -%}
          {%- else -%}
            <a href="{{ routes.root_url }}" class="nav-link">{{ 'nav.home' | t }}</a>
            <a href="{{ routes.all_products_collection_url }}" class="nav-link">{{ 'nav.shop' | t }}</a>
            <a href="{% render 'customize-url' %}" class="nav-link">{{ 'nav.menu.customize' | t }}</a>
            <a href="/pages/contact" class="nav-link">{{ 'nav.menu.contact' | t }}</a>
          {%- endfor -%}
        </nav>
      </div>

      <a class="header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {%- if s.logo != blank -%}
          <img src="{{ s.logo | image_url: height: 88 }}" alt="{{ shop.name | escape }}" height="{{ s.logo_height | default: 24 }}" width="{{ s.logo.width | times: s.logo_height | divided_by: s.logo.height }}" loading="eager">
        {%- else -%}
          {% render 'brand-logo', class: 'header__logo-mark', height: s.logo_height %}
        {%- endif -%}
      </a>

      <div class="header__end">
        {%- if localization.available_languages.size > 1 -%}
          {%- form 'localization', id: 'HeaderLanguageForm', class: 'header__locale-form' -%}
            <div class="header__locale" style="position: relative;">
              <button type="button" class="icon-btn" aria-label="{{ 'general.english' | t }} / {{ 'general.arabic' | t }}" onclick="this.nextElementSibling.toggleAttribute('hidden')">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/><path d="M2 12h20"/></svg>
              </button>
              <div class="header__locale-dropdown glass" hidden style="position:absolute;top:calc(100% + 8px);inset-inline-end:0;padding:8px;border-radius:var(--r-md);display:flex;flex-direction:column;gap:4px;z-index:10;min-width:110px;">
                {%- for language in localization.available_languages -%}
                  <button type="submit" name="locale_code" value="{{ language.iso_code }}" class="btn btn--sm {% if language.iso_code == localization.language.iso_code %}btn--primary{% else %}btn--ghost{% endif %}">{{ language.endonym_name }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endform -%}
        {%- endif -%}
        <button class="icon-btn" type="button" data-drawer-open="search" aria-label="{{ 'search.title' | t }}" aria-expanded="false">
          {% render 'icon', name: 'search' %}
        </button>
        {%- if settings.show_wishlist != false -%}
        <a class="icon-btn header__wishlist" href="{{ routes.search_url }}?view=wishlist" data-wishlist-link aria-label="{{ 'wishlist.title' | t }}">
          {% render 'icon', name: 'heart' %}<span class="badge header__count" data-wishlist-count hidden>0</span>
        </a>
        {%- endif -%}
        {%- if settings.cart_type == 'page' -%}
          <a class="icon-btn header__cart" href="{{ routes.cart_url }}" aria-label="{{ 'cart.title' | t }}">
        {%- else -%}
          <button class="icon-btn header__cart" type="button" data-drawer-open="cart" aria-label="{{ 'cart.title' | t }}" aria-expanded="false">
        {%- endif -%}
          {% render 'icon', name: 'bag' %}
          <span class="badge header__count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{% render 'digits', value: cart.item_count %}</span>
        {%- if settings.cart_type == 'page' -%}</a>{%- else -%}</button>{%- endif -%}
        {%- if s.show_shop_cta -%}
          {%- assign shop_cta_url = s.shop_cta_url | default: routes.all_products_collection_url -%}
          <a href="{% render 'nav-url', url: shop_cta_url %}" class="btn btn--primary btn--sm header__cta">{% render 'tr', value: s.shop_cta_label, key: 'home.shop_cta' %}</a>
        {%- endif -%}
      </div>
    </div>
  </header>
</div>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (leave empty for the built-in LINUX wordmark)"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_shop_cta",
      "label": "Show Shop button",
      "default": true
    },
    {
      "type": "text",
      "id": "shop_cta_label",
      "label": "Shop button label (blank = translated)"
    },
    {
      "type": "url",
      "id": "shop_cta_url",
      "label": "Shop button link"
    },
    {
      "type": "header",
      "content": "Announcement"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Text (blank = translated)"
    },
    {
      "type": "select",
      "id": "announcement_style",
      "label": "Announcement style",
      "default": "rotate",
      "options": [
        {
          "value": "rotate",
          "label": "Rotating messages"
        },
        {
          "value": "marquee",
          "label": "Scrolling ticker"
        }
      ]
    },
    {
      "type": "range",
      "id": "announcement_interval",
      "label": "Seconds per message",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "text",
      "id": "announcement_countdown_end",
      "label": "Countdown end (optional)",
      "info": "Same format as the hero countdown, e.g. 2026-11-30T23:59:00+02:00. Blank = no timer; it hides itself when the time passes."
    },
    {
      "type": "text",
      "id": "announcement_countdown_label",
      "label": "Countdown label (blank = translated)"
    },
    {
      "type": "paragraph",
      "content": "Add Announcement blocks for the rotating messages. Leave a message blank to use its translation key, so it switches between Arabic and English on its own."
    }
  ],
  "blocks": [
    {
      "type": "mega_promo",
      "name": "Mega menu promo",
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "Menu item title (must match)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "announcement",
      "name": "Announcement",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message (blank = translation key)"
        },
        {
          "type": "text",
          "id": "key",
          "label": "Translation key",
          "info": "e.g. cart.offer_bar (uses your free-delivery threshold), home.marquee_3, announcement.customize, announcement.welcome"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "sparkle",
          "options": [
            {
              "value": "sparkle",
              "label": "Sparkle"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "cash",
              "label": "Cash"
            },
            {
              "value": "exchange",
              "label": "Exchange"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "tag",
              "label": "Tag"
            },
            {
              "value": "percent",
              "label": "Percent"
            },
            {
              "value": "ticket",
              "label": "Ticket"
            },
            {
              "value": "gift",
              "label": "Gift"
            },
            {
              "value": "flame",
              "label": "Flame"
            },
            {
              "value": "needle",
              "label": "Needle"
            },
            {
              "value": "clock",
              "label": "Clock"
            },
            {
              "value": "bell",
              "label": "Bell"
            },
            {
              "value": "none",
              "label": "None"
            }
          ]
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "code",
          "label": "Discount code (tap to copy)",
          "info": "Must exist in Shopify → Discounts."
        }
      ]
    }
  ]
}
{% endschema %}
