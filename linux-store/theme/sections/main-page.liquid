<section class="page wrap">
  <header class="page__head" data-reveal>
    <p class="eyebrow">{{ shop.name }}</p>
    <h1>{% render 'menu-title', title: page.title %}</h1>
  </header>
  <div class="page__body glass" data-reveal><div class="rte">{%- assign page_fallback = 'general.page_untranslated' | t -%}{% render 'localized-content', content: page.content, fallback: page_fallback %}</div></div>
</section>
{% schema %}
{ "name": "Page", "settings": [] }
{% endschema %}
