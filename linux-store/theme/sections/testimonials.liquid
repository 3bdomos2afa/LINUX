{%- assign s = section.settings -%}
<section class="section wrap{% if section.settings.scheme == 'cream' or section.settings.scheme == 'lime' %} sheet scheme-{{ section.settings.scheme }}{% endif %}" id="s-{{ section.id }}">
  <div class="section-head">
    <div class="section-head__text" data-reveal>
      <p class="eyebrow">{% if s.number != blank %}<span class="eyebrow__num">{% render 'digits', value: s.number %}</span>{% endif %}{% render 'tr', value: s.eyebrow, key: 'home.reviews_eyebrow' %}</p>
      <h2>{% render 'tr', value: s.heading, key: 'home.reviews_heading' %}</h2>
    </div>
    {%- capture review_rating -%}{% render 'tr', value: s.rating_text, key: 'home.reviews_rating' %}{%- endcapture -%}
    <p class="chip" data-reveal>{% render 'icon', name: 'star', px: 14 %} {% render 'digits', value: review_rating %}</p>
  </div>
  <div class="reviews">
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <blockquote class="review glass glass--hover" data-reveal style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
        <div class="review__stars" aria-label="{% render 'digits', value: b.rating %}/{% render 'digits', value: 5 %}">{%- for i in (1..5) -%}{%- if i <= b.rating -%}{% render 'icon', name: 'star', px: 16 %}{%- endif -%}{%- endfor -%}</div>
        {%- capture who -%}{% render 'tr', value: b.name, key: b.key_name %}{%- endcapture -%}{%- capture where -%}{% render 'tr', value: b.meta, key: b.key_meta %}{%- endcapture -%}
        <p class="review__quote">“{% render 'tr', value: b.quote, key: b.key_quote %}”</p>
        <footer class="review__who">
          <span class="review__avatar">{{ who | strip | slice: 0 }}</span>
          <span><strong>{{ who | strip }}</strong>{% if where != blank %} · {{ where | strip }}{% endif %}</span>
          <span class="review__verified">{% render 'icon', name: 'check', px: 12 %}{{ 'sections.reviews.verified' | t }}</span>
        </footer>
      </blockquote>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour",
      "default": "forest",
      "options": [
        {
          "value": "forest",
          "label": "Forest (dark)"
        },
        {
          "value": "cream",
          "label": "Cream sheet"
        },
        {
          "value": "lime",
          "label": "Lime sheet"
        }
      ]
    },
    {
      "type": "text",
      "id": "number",
      "label": "Section number",
      "default": "05"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (blank = translated)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (blank = translated)"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating chip (blank = translated)"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Meta"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "key_quote",
          "label": "Translation key — quote (optional)"
        },
        {
          "type": "text",
          "id": "key_name",
          "label": "Translation key — name (optional)"
        },
        {
          "type": "text",
          "id": "key_meta",
          "label": "Translation key — city (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "quote"
        },
        {
          "type": "quote"
        },
        {
          "type": "quote"
        }
      ]
    }
  ]
}
{% endschema %}
