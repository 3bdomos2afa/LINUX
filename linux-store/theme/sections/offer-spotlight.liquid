{%- comment -%}
  Offer spotlight: one campaign in a large glass card — art or product photo,
  a tap-to-copy code, a live countdown to the real end time and a CTA.
  Blank text fields fall back to the theme translation (Arabic/English).
  The code must exist in Shopify → Discounts; this card only displays it.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign end_at = s.end_at | default: '' | strip
  assign spot_product = s.product
-%}
{{ 'section-promo.css' | asset_url | stylesheet_tag }}
<section class="section offer-spot" data-offer-spot{% if s.hide_when_ended and end_at != blank %} data-hide-ended="{{ end_at | escape }}"{% endif %}>
  <div class="wrap">
    <div class="offer-spot__card glass" data-specular data-reveal>
      <div class="offer-spot__media">
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 760px) 45vw, 100vw', class: 'offer-spot__img' }}
        {%- elsif spot_product != blank and spot_product.featured_image != blank -%}
          {{ spot_product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200', sizes: '(min-width: 760px) 45vw, 100vw', class: 'offer-spot__img' }}
        {%- else -%}
          <img class="offer-spot__img--art" src="{{ 'mascot-hoodie-sit.webp' | asset_url }}" alt="" width="600" height="600" loading="lazy" decoding="async">
        {%- endif -%}
        {%- if s.show_badge -%}<span class="offer-spot__burst" aria-hidden="true">{% render 'icon', name: 'percent', px: 26 %}</span>{%- endif -%}
      </div>
      <div class="offer-spot__body">
        <p class="eyebrow">{% render 'tr', value: s.eyebrow, key: 'offers.spot_eyebrow' %}</p>
        <h2 class="offer-spot__title">{% render 'tr', value: s.heading, key: 'offers.spot_heading' %}</h2>
        <p class="offer-spot__text">{% render 'tr', value: s.text, key: 'offers.spot_text' %}</p>
        {%- if end_at != blank -%}
          <div class="offer-timer" data-countdown data-countdown-end="{{ end_at | escape }}" hidden>
            <p class="offer-timer__row" data-countdown-active role="timer" aria-label="{{ 'sections.hero.countdown_label' | t | escape }}">
              <span class="offer-timer__unit"><b data-cd="days">--</b><small>{{ 'offers.days' | t }}</small></span>
              <span class="offer-timer__unit"><b data-cd="hours">--</b><small>{{ 'offers.hours' | t }}</small></span>
              <span class="offer-timer__unit"><b data-cd="minutes">--</b><small>{{ 'offers.minutes' | t }}</small></span>
              <span class="offer-timer__unit"><b data-cd="seconds">--</b><small>{{ 'offers.seconds' | t }}</small></span>
            </p>
            <p class="offer-timer__done" data-countdown-expired role="status">{{ 'sections.hero.countdown_expired' | t }}</p>
          </div>
        {%- endif -%}
        <div class="offer-spot__actions">
          {%- if s.code != blank -%}
            <button class="offer-code" type="button" data-copy="{{ s.code | strip | escape }}" data-copy-label="{{ 'announcement.code_copied' | t | escape }}" aria-label="{{ 'cart.offer_copy' | t: code: s.code | escape }}">
              <span class="offer-code__label">{{ 'offers.code_label' | t }}</span>
              <span class="offer-code__value">{{ s.code | strip }}</span>
              {%- render 'icon', name: 'copy', px: 16 -%}
            </button>
          {%- endif -%}
          {%- assign spot_url = s.cta_url | default: routes.all_products_collection_url -%}
          <a class="btn btn--primary btn--lg" href="{% render 'nav-url', url: spot_url %}" data-magnetic>{% render 'tr', value: s.cta_label, key: 'offers.spot_cta' %}{% render 'icon', name: 'arrow-right' %}</a>
        </div>
        {%- capture spot_note -%}{% render 'tr', value: s.note, key: 'offers.spot_note' %}{%- endcapture -%}
        {%- if s.show_note and spot_note != blank -%}<p class="offer-spot__note small">{% render 'icon', name: 'info', px: 14 %} {{ spot_note }}</p>{%- endif -%}
      </div>
    </div>
  </div>
</section>
<script src="{{ 'promo.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Offer spotlight",
  "tag": "div",
  "class": "section-offer-spotlight",
  "settings": [
    { "type": "paragraph", "content": "Blank text = the theme's Arabic/English copy. The code must exist in Shopify → Discounts — this card only shows it." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "code", "label": "Discount code (tap to copy)", "default": "LINUX10" },
    { "type": "text", "id": "end_at", "label": "Offer end (optional)", "info": "e.g. 2026-11-30T23:59:00+02:00 — shows a live countdown. Blank = no timer." },
    { "type": "checkbox", "id": "hide_when_ended", "label": "Hide the card after the end time", "default": true },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Blank = the product photo below, else the LINUX penguin." },
    { "type": "product", "id": "product", "label": "Product photo (optional)" },
    { "type": "checkbox", "id": "show_badge", "label": "Show the % badge", "default": true },
    { "type": "checkbox", "id": "show_note", "label": "Show the small print", "default": true },
    { "type": "text", "id": "note", "label": "Small print" }
  ],
  "presets": [{ "name": "Offer spotlight" }]
}
{% endschema %}
