[[> file_header]]
[[> setup]]
{%- assign lx_context = 'order' -%}
{%- assign lx_step = 3 -%}
[[> head]]
[[> shell_open]]
[[> hero_open]]
[[> eyebrow]]
[[> h1]]
<p style="[[s.body]]">[[body]]</p>
{%- if financial_status == 'pending' -%}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" dir="[[dir]]" bgcolor="[[c.panel]]" style="margin-top:16px;border-collapse:separate;background-color:[[c.panel]];border:1px solid [[c.border]];border-radius:18px;">
<tr>
<td style="padding:12px 16px;font-family:[[font]];font-size:14px;line-height:22px;color:[[c.text]];text-align:[[start]];">💵&nbsp; [[cod_note]]</td>
</tr>
</table>
{%- endif -%}
[[> steps]]
[[> tracking]]
[[> hero_close]]
[[> card_open]]
<p style="[[s.label]]">[[shipment_items]]</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" dir="[[dir]]">
{%- for lx_fl in fulfillment.fulfillment_line_items -%}
{%- assign lx_line = lx_fl.line_item -%}
{%- assign lx_qty = lx_fl.quantity -%}
{%- assign lx_show_price = false -%}
[[> line_item]]
{%- endfor -%}
</table>
[[> card_close]]
[[> address]]
[[> help]]
[[> footer]]
