[[> file_header]]
[[> setup]]
{%- assign lx_context = 'checkout' -%}
{%- assign lx_step = 0 -%}
[[> head]]
[[> shell_open]]
[[> hero_open]]
[[> eyebrow]]
[[> h1]]
<p style="[[s.body]]">[[body]]</p>
[[> custom_message]]
{%- assign lx_btn_url = url -%}
{%- capture lx_btn_text -%}[[cta]]{%- endcapture -%}
{%- assign lx_btn2_url = store_url -%}
{%- capture lx_btn2_text -%}[[visit_store]]{%- endcapture -%}
[[> buttons]]
[[> link_fallback]]
[[> hero_close]]
[[> card_open]]
<p style="[[s.label]]">[[items]]</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" dir="[[dir]]">
{%- for lx_line in line_items -%}
{%- assign lx_qty = lx_line.quantity -%}
{%- assign lx_show_price = true -%}
[[> line_item]]
{%- endfor -%}
</table>
{%- if subtotal_price -%}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" dir="[[dir]]" style="margin-top:4px;border-top:1px solid [[c.border]];">
<tr>
<td style="padding:14px 0 0;font-family:[[font]];font-size:16px;line-height:24px;font-weight:800;color:[[c.cream]];text-align:[[start]];">[[subtotal]]</td>
<td style="padding:14px 0 0;font-family:[[font]];font-size:18px;line-height:24px;font-weight:800;color:[[c.cream]];text-align:[[end]];white-space:nowrap;"><span dir="ltr">{{ subtotal_price | money }}</span></td>
</tr>
</table>
{%- endif -%}
<p style="[[s.note]]">[[shipping_note]]</p>
[[> card_close]]
[[> help]]
[[> footer]]
