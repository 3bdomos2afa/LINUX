[[> file_header]]
[[> setup]]
{%- assign lx_context = 'order' -%}
{%- assign lx_step = 0 -%}
{%- capture lx_refund -%}{%- case financial_status -%}{%- when 'refunded', 'partially_refunded' -%}[[refund_refunded]]{%- when 'voided', 'authorized' -%}[[refund_voided]]{%- when 'pending' -%}[[refund_pending]]{%- when 'paid', 'partially_paid' -%}[[refund_paid]]{%- endcase -%}{%- endcapture -%}
[[> head]]
[[> shell_open]]
[[> hero_open]]
[[> eyebrow]]
[[> h1]]
<p style="[[s.body]]">{%- case cancel_reason -%}{%- when 'customer' -%}[[reason_customer]]{%- when 'inventory' -%}[[reason_inventory]]{%- when 'declined' -%}[[reason_declined]]{%- else -%}[[reason_other]]{%- endcase -%}</p>
{%- if lx_refund != '' -%}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" dir="[[dir]]" bgcolor="[[c.panel]]" style="margin-top:16px;border-collapse:separate;background-color:[[c.panel]];border:1px solid [[c.border]];border-radius:18px;">
<tr>
<td style="padding:12px 16px;font-family:[[font]];font-size:14px;line-height:22px;color:[[c.text]];text-align:[[start]];">{{ lx_refund }}</td>
</tr>
</table>
{%- endif -%}
{%- assign lx_btn_url = store_url -%}
{%- capture lx_btn_text -%}[[shop_latest]]{%- endcapture -%}
{%- assign lx_btn2_url = '' -%}
[[> buttons]]
[[> hero_close]]
[[> card_open]]
<p style="[[s.label]]">[[items]]</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" dir="[[dir]]">
{%- for lx_line in subtotal_line_items -%}
{%- assign lx_qty = lx_line.quantity -%}
{%- assign lx_show_price = true -%}
[[> line_item]]
{%- endfor -%}
</table>
[[> totals]]
[[> card_close]]
[[> help]]
[[> footer]]
