<!DOCTYPE html>
<html lang="[[lang]]" dir="[[dir]]" xmlns="http://www.w3.org/1999/xhtml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="x-apple-disable-message-reformatting">
<meta name="format-detection" content="telephone=no, date=no, address=no, email=no, url=no">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>[[title]]</title>
<!--[if mso]><noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript><![endif]-->
<style>
:root { color-scheme: light dark; supported-color-schemes: light dark; }
body { margin: 0; padding: 0; width: 100%; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
img { border: 0; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; }
table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
.lx-addr p { margin: 0 !important; }
a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important; }
@media only screen and (max-width: 620px) {
  .lx-outer { padding: 16px 10px 28px !important; }
  .lx-pad { padding-left: 20px !important; padding-right: 20px !important; }
  .lx-h1 { font-size: [[h1_size_m]] !important; line-height: [[h1_lh_m]] !important; }
  .lx-stack { display: block !important; width: 100% !important; box-sizing: border-box; }
  .lx-stack-gap { padding: 0 0 12px 0 !important; }
  .lx-btn-cell { display: block !important; width: 100% !important; padding: 0 0 10px 0 !important; }
  .lx-btns, .lx-btn-table { width: 100% !important; }
  .lx-btn-link { display: block !important; text-align: center !important; }
  .lx-total-v { font-size: 18px !important; }
  .lx-thumb, .lx-thumb img, .lx-thumb div { width: 60px !important; height: 60px !important; }
}
@media only screen and (max-width: 360px) {
  .lx-outer { padding: 12px 6px 24px !important; }
  .lx-pad { padding-left: 16px !important; padding-right: 16px !important; }
  .lx-total-v { font-size: 16px !important; }
}
</style>
</head>
<body style="margin:0;padding:0;width:100%;background-color:[[c.page]];" bgcolor="[[c.page]]">
<div style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;color:[[c.page]];">[[preheader]]{%- for lx_i in (1..40) -%}&#847;&zwnj;&nbsp;{%- endfor -%}</div>
