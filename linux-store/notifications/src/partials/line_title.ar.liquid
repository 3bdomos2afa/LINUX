{%- comment -%} Shopify translates line.title (product - variant) to the checkout language; drop the variant part, then apply the storefront's word-level Arabic fallback for untranslated titles. {%- endcomment -%}
{%- assign lx_title = lx_line.title | default: lx_line.product.title | default: '' -%}
{%- if lx_variant != '' and lx_title contains ' - ' -%}
{%- assign lx_tparts = lx_title | split: ' - ' -%}
{%- capture lx_title -%}{%- for lx_tp in lx_tparts -%}{%- unless forloop.last -%}{%- unless forloop.first -%}{{ ' - ' }}{%- endunless -%}{{ lx_tp }}{%- endunless -%}{%- endfor -%}{%- endcapture -%}
{%- endif -%}
{%- assign lx_has_ar = false -%}
{%- for lx_ch in lx_probe -%}{%- if lx_title contains lx_ch -%}{%- assign lx_has_ar = true -%}{%- break -%}{%- endif -%}{%- endfor -%}
{%- if lx_has_ar -%}
{%- assign lx_title = lx_title | strip | escape -%}
{%- else -%}
{%- assign lx_words = lx_title | split: ' ' -%}
{%- capture lx_title -%}{%- for lx_val in lx_words -%}[[> value_map]]{%- unless forloop.last %} {% endunless -%}{%- endfor -%}{%- endcapture -%}
{%- assign lx_title = lx_title | strip -%}
{%- endif -%}
