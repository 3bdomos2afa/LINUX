{%- if financial_status == 'paid' -%}
<p style="margin:12px 0 0;font-family:[[font]];font-size:13px;line-height:20px;color:[[c.muted]];text-align:[[start]];">[[payment]]: <strong style="color:[[c.lime]];">[[paid]]</strong></p>
{%- elsif financial_status == 'pending' -%}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" dir="[[dir]]" bgcolor="[[c.panel]]" style="margin-top:14px;border-collapse:separate;background-color:[[c.panel]];border:1px solid [[c.border]];border-radius:18px;">
<tr>
<td style="padding:12px 16px;font-family:[[font]];font-size:13px;line-height:20px;color:[[c.text]];text-align:[[start]];">💵&nbsp; [[payment_pending]]</td>
</tr>
</table>
{%- endif -%}
