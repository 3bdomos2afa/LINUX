{%- for lx_da in lx_line.discount_allocations -%}
{%- if lx_da.discount_application.target_selection != 'all' and lx_da.amount > 0 -%}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:8px;border-collapse:separate;">
<tr>
<td bgcolor="[[c.chip]]" style="padding:4px 11px;border-radius:999px;background-color:[[c.chip]];font-family:[[font]];font-size:12px;line-height:17px;font-weight:700;color:[[c.lime]];">🏷&nbsp;{{ lx_da.discount_application.title | escape }} <span dir="ltr" style="white-space:nowrap;">(−{{ lx_da.amount | money }})</span></td>
</tr>
</table>
{%- endif -%}
{%- endfor -%}
