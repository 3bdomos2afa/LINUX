[[> card_open]]
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" dir="[[dir]]">
<tr>
<td width="44" valign="top" style="width:44px;">
<div style="width:44px;height:44px;border-radius:15px;background-color:[[c.chip]];text-align:center;font-size:21px;line-height:44px;">🧵</div>
</td>
<td width="14" style="width:14px;font-size:1px;line-height:1px;">&nbsp;</td>
<td valign="top" style="text-align:[[start]];font-family:[[font]];">
<p style="[[s.h2]]">[[custom_title]]</p>
<p style="[[s.text]]">[[custom_body]]</p>
</td>
</tr>
</table>
[[> card_close]]
