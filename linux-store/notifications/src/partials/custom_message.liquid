{%- if custom_message != blank -%}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" dir="[[dir]]" bgcolor="[[c.panel]]" style="margin-top:18px;border-collapse:separate;background-color:[[c.panel]];border:1px solid [[c.border]];border-radius:18px;">
<tr>
<td style="padding:14px 18px;font-family:[[font]];font-size:14px;line-height:22px;color:[[c.text]];text-align:[[start]];">{{ custom_message }}</td>
</tr>
</table>
{%- endif -%}
