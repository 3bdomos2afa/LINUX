<p style="margin:6px 0 0;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;font-size:12px;line-height:19px;color:#aeb5a6;">{%- case lx_context -%}{%- when 'order' -%}You're receiving this email because you placed an order with LINUX.{%- when 'checkout' -%}You're receiving this email because you started a checkout with LINUX.{%- else -%}You're receiving this email because of activity on your LINUX account.{%- endcase -%}</p>
<p style="margin:10px 0 0;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;font-size:12px;line-height:18px;"><a href="{{ store_url }}" target="_blank" style="color:#8fcb5a;text-decoration:none;font-weight:700;"><span dir="ltr">{{ shop.url | remove: 'https://' | remove: 'http://' }}</span></a></p>
