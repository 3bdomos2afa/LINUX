{%- assign lx_tdir = 'ltr' -%}
{%- for lx_ch in lx_probe -%}{%- if lx_dir_text contains lx_ch -%}{%- assign lx_tdir = 'rtl' -%}{%- break -%}{%- endif -%}{%- endfor -%}<span dir="{{ lx_tdir }}">{{ lx_pv | escape | newline_to_br }}</span>
{%- else -%}{%- assign lx_val = lx_pv -%}{%- capture lx_mapped -%}{%- assign lx_vk = lx_val | downcase | strip -%}
{%- case lx_vk -%}
{%- when 'xs', 's', 'm', 'l', 'xl', 'xxl', '2xl', 'xxxl', '3xl', '4xl', '5xl' -%}{{ lx_val | upcase | escape }}
{%- when 'front + back' -%}Front + Back
{%- else -%}{%- if lx_val == lx_vk -%}{{ lx_val | capitalize | escape }}{%- else -%}{{ lx_val | escape }}{%- endif -%}
{%- endcase -%}{%- endcapture -%}{%- assign lx_dir_text = lx_mapped -%}{%- comment -%} Sets lx_tdir to rtl when lx_dir_text contains Arabic letters, so shopper-typed text keeps its punctuation in place. {%- endcomment -%}
{%- assign lx_tdir = 'ltr' -%}
{%- for lx_ch in lx_probe -%}{%- if lx_dir_text contains lx_ch -%}{%- assign lx_tdir = 'rtl' -%}{%- break -%}{%- endif -%}{%- endfor -%}<span dir="{{ lx_tdir }}">{{ lx_mapped }}</span>
{%- endif -%}
</td>
</tr>
