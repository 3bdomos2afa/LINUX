<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" dir="ltr">
{%- for lx_fl in fulfillment.fulfillment_line_items -%}
{%- assign lx_line = lx_fl.line_item -%}
{%- assign lx_qty = lx_fl.quantity -%}
{%- assign lx_show_price = false -%}
{%- comment -%} One line row. Inputs: lx_line (line item), lx_qty, lx_show_price. {%- endcomment -%}
{%- assign lx_is_first = forloop.first -%}
{%- assign lx_variant = lx_line.variant.title | default: '' -%}
{%- if lx_variant == 'Default Title' -%}{%- assign lx_variant = '' -%}{%- endif -%}
{%- assign lx_title = lx_line.product.title | default: lx_line.title | escape -%}
{%- comment -%} Customize-studio pieces show the shopper's own mockup (back first, like the storefront bag). {%- endcomment -%}
{%- assign lx_mock = '' -%}
{%- for p in lx_line.properties -%}
{%- assign lx_pv = p.last | append: '' -%}
{%- assign lx_pv8 = lx_pv | slice: 0, 8 -%}
{%- if lx_pv8 == 'https://' and p.first == 'Back mockup' -%}{%- assign lx_mock = lx_pv -%}{%- endif -%}
{%- if lx_pv8 == 'https://' and p.first == 'Front mockup' and lx_mock == '' -%}{%- assign lx_mock = lx_pv -%}{%- endif -%}
{%- endfor -%}
{%- if lx_mock != '' -%}
{%- assign lx_img = lx_mock -%}
{%- elsif lx_line.image -%}
{%- assign lx_img = lx_line | img_url: 'compact_cropped' -%}
{%- else -%}
{%- assign lx_img = '' -%}
{%- endif -%}
{%- assign lx_img2 = lx_img | slice: 0, 2 -%}
{%- if lx_img2 == '//' -%}{%- assign lx_img = lx_img | prepend: 'https:' -%}{%- endif -%}
{%- capture lx_variant_label -%}
{%- if lx_variant != '' -%}
{%- assign lx_parts = lx_variant | split: ' / ' -%}
{%- for lx_val in lx_parts -%}{%- assign lx_vk = lx_val | downcase | strip -%}
{%- case lx_vk -%}
{%- when 'xs', 's', 'm', 'l', 'xl', 'xxl', '2xl', 'xxxl', '3xl', '4xl', '5xl' -%}{{ lx_val | upcase | escape }}
{%- when 'front + back' -%}Front + Back
{%- else -%}{%- if lx_val == lx_vk -%}{{ lx_val | capitalize | escape }}{%- else -%}{{ lx_val | escape }}{%- endif -%}
{%- endcase -%}{%- unless forloop.last %} / {% endunless -%}{%- endfor -%}
{%- endif -%}
{%- endcapture -%}
<tr>
<td style="padding:{% if lx_is_first %}6px{% else %}16px{% endif %} 0 16px;{% unless lx_is_first %}border-top:1px solid #284c3c;{% endunless %}">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" dir="ltr">
