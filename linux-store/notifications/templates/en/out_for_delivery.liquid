{%- when 'color' -%}Colour
{%- when 'notes' -%}Your notes
{%- else -%}{{ lx_pk | escape }}
{%- endcase -%}:&nbsp;</span>
{%- if lx_pv8 == 'https://' or lx_pv7 == 'http://' -%}<a href="{{ lx_pv | escape }}" target="_blank" style="color:#8fcb5a;text-decoration:underline;">View file</a>
