<td valign="top" style="text-align:left;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" dir="ltr">
<tr>
<td valign="top" style="text-align:left;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;font-size:15px;line-height:22px;font-weight:700;color:#f4e8d8;">{{ lx_title }}</td>
{%- if lx_show_price -%}
<td valign="top" style="padding-left:12px;text-align:right;white-space:nowrap;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
{%- if lx_line.original_line_price > lx_line.final_line_price -%}
<p style="margin:0;font-size:12px;line-height:18px;color:#aeb5a6;text-decoration:line-through;"><span dir="ltr">{{ lx_line.original_line_price | money }}</span></p>
{%- endif -%}
<p style="margin:0;font-size:15px;line-height:22px;font-weight:800;color:#ffffff;">{%- if lx_line.final_line_price > 0 -%}<span dir="ltr">{{ lx_line.final_line_price | money }}</span>{%- else -%}Free{%- endif -%}</p>
</td>
{%- endif -%}
</tr>
</table>
{%- if lx_variant_label != '' -%}
<p style="margin:2px 0 0;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;font-size:13px;line-height:20px;color:#cfcfbf;">{{ lx_variant_label }}</p>
{%- endif -%}
{%- comment -%} Line-item properties. Skips blanks, keys starting with "_", mockups (already the thumbnail), placement data and the bundle estimate. {%- endcomment -%}
{%- capture lx_props -%}
{%- for p in lx_line.properties -%}
{%- assign lx_pk = p.first | append: '' -%}
{%- assign lx_pk1 = lx_pk | slice: 0 -%}
{%- assign lx_pkd = lx_pk | downcase | strip -%}
{%- assign lx_pv = p.last | append: '' | strip -%}
{%- assign lx_skip = false -%}
{%- if lx_pv == '' or lx_pk1 == '_' -%}{%- assign lx_skip = true -%}{%- endif -%}
{%- if lx_pkd == 'front mockup' or lx_pkd == 'back mockup' or lx_pkd == 'expected bundle discount' -%}{%- assign lx_skip = true -%}{%- endif -%}
{%- if lx_pkd contains 'position' -%}{%- assign lx_skip = true -%}{%- endif -%}
{%- unless lx_skip -%}
{%- assign lx_pv2 = lx_pv | slice: 0, 2 -%}
{%- if lx_pv2 == '//' -%}{%- assign lx_pv = lx_pv | prepend: 'https:' -%}{%- endif -%}
{%- assign lx_pv8 = lx_pv | slice: 0, 8 -%}
{%- assign lx_pv7 = lx_pv | slice: 0, 7 -%}
<tr>
<td style="padding:2px 0;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;font-size:13px;line-height:19px;color:#cfcfbf;text-align:left;"><span style="font-weight:700;color:#f4e8d8;">{%- case lx_pkd -%}
